<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- [파이프라인 1] 실시간 카메라 프리뷰 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- [Debug View] Canny / ROI Edge / Morphology intermediate frame overlay -->
    <ImageView
        android:id="@+id/ivDebugFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- [요소기술 2-1] ROI 가이드라인 오버레이 (사다리꼴) -->
    <View
        android:id="@+id/roiGuide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/roi_overlay" />

    <!-- 상단 Status: SAFE / CAUTION / DANGER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/statusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        app:cardBackgroundColor="#80000000"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="32dp"
            android:paddingVertical="12dp"
            android:text="SYSTEM READY"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Runtime tuning controls for outdoor calibration -->
    <LinearLayout
        android:id="@+id/tuningPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:background="#B3000000"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/spinnerTuningParam"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="#E6FFFFFF"
                android:spinnerMode="dropdown" />

            <EditText
                android:id="@+id/etTuningValue"
                android:layout_width="96dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="#E6FFFFFF"
                android:gravity="center"
                android:hint="Value"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal|numberSigned"
                android:maxLines="1"
                android:textColor="#111111"
                android:textColorHint="#666666"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplyTuning"
                android:layout_width="86dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="APPLY"
                android:textSize="11sp"
                app:backgroundTint="#FFB300"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTuningFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:text="Canny Low = 70"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 하단 Data Panel: Area 및 Buffer 상태 -->
    <LinearLayout
        android:id="@+id/dataPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="#A6000000"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvAreaData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detected Area: 0.0"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvBufferData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Hazard Buffer: [----------]"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- [Software Tech: Control UI] Stop Service Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopService"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Stop Monitoring"
        app:cornerRadius="20dp"
        app:backgroundTint="#80FF0000"
        app:layout_constraintBottom_toTopOf="@id/dataPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- [Debug Control] Cycle Camera / Canny / ROI Edge / Morphology views -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDebugView"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:text="CAMERA"
        android:textSize="11sp"
        app:backgroundTint="#AA263238"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
